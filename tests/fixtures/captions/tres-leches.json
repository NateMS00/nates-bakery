{"language": "Spanish", "title": "Three milk cake", "category": "cake", "yield": null, "totalTime": null, "ingredientGroups": [{"name": null, "items": [{"name": "eggs", "amount": "4 piezas", "parts": [{"qty": "4", "unit": "piece"}], "note": null}, {"name": "sugar", "amount": "120gramos", "parts": [{"qty": "120", "unit": "g"}], "note": "I would put 100grams next time so it's not so sweet (original recipe says 150grams)"}, {"name": "vanilla", "amount": "Una cucharadita", "parts": [{"qty": "1", "unit": "tsp"}], "note": null}, {"name": "all-purpose flour, sifted", "amount": "95 gramos", "parts": [{"qty": "95", "unit": "g"}], "note": null}]}, {"name": "For the liquid", "items": [{"name": "condensed milk", "amount": "1 lata", "parts": [{"qty": "1", "unit": "can"}], "note": null}, {"name": "evaporated milk", "amount": "1", "parts": [{"qty": "1", "unit": "other"}], "note": null}, {"name": "heavy cream", "amount": "1", "parts": [{"qty": "1", "unit": "other"}], "note": null}]}], "stepGroups": [{"name": null, "steps": [{"text": "Make holes and add the liquid just out of the oven; it turned out PERFECT. If you want to let it cool you can too; for me it's better hot but both recipes WORK.", "uses": ["eggs", "sugar", "vanilla", "all-purpose flour, sifted", "condensed milk", "evaporated milk", "heavy cream"]}, {	ext": "TIP: I don't have patience BUT if you let it cool all night and then decorate and try it it's MUCH BETTER.", "uses": []}]}]}