# Copy to .env.local (git-ignored) for `npm run dev:supabase`, and set the same names in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Supabase → Project Settings → API (or Connect). The public key is safe in the browser:
# row-level security decides what it can do. Never use the secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Optional features (off unless "on"). Import from a reel needs the import service.
# BACKERY_FEATURE_IMPORT=on

# Tests only (never set in Vercel):
# BACKERY_TEST_DATABASE_URL=postgresql://…   (Connect → Session pooler; contains the database password)
# BACKERY_TEST_SHARE_TOKEN=…                  (a share link's token, for the shared-recipe field check)
