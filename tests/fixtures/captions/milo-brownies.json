{"language": "Spanish", "title": "Brownies de Milo", "category": "cookie-bar", "yield": {"quantity": 6, "unit": "porción", "unitPlural": "porciones"}, "totalTime": {"hours": 0, "minutes": 35}, "ingredientGroups": [{"name": null, "items": [{"name": "eggs", "amount": null, "parts": [{"qty": "2", "unit": "piece"}], "note": null}, {"name": "unsalted butter", "amount": "1 barrita", "parts": [{"qty": "1", "unit": "stick"}], "note": "melted"}, {"name": "white sugar", "amount": "1/2 taza", "parts": [{"qty": "1/2", "unit": "cup"}], "note": null}, {"name": "brown sugar", "amount": "1/2 taza", "parts": [{"qty": "1/2", "unit": "cup"}], "note": null}, {"name": "salt", "amount": "1/4 cdta", "parts": [{"qty": "1/4", "unit": "tsp"}], "note": null}, {"name": "Milo", "amount": "1/2 taza", "parts": [{"qty": "1/2", "unit": "cup"}], "note": null}, {"name": "powdered milk", "amount": "1/4 taza", "parts": [{"qty": "1/4", "unit": "cup"}], "note": "optional, gives a more dairy and very melcochudo flavor - if you don't add it, replace with flour"}, {"name": "flour", "amount": "3/4 taza", "parts": [{"qty": "3/4", "unit": "cup"}], "note": null}]}], "stepGroups": [{"name": null, "steps": [{"text": "Mix the eggs with the sugar.", "uses": ["eggs", "white sugar", "brown sugar"]}, {	ext": "Then add the melted butter and mix.", "uses": ["unsalted butter"]}, {	ext": "Add the Milo and powdered milk.", "uses": ["Milo", "powdered milk"]}, {	ext": "Add the flour and salt and mix until combined.", "uses": ["flour", "salt"]}, {	ext": "Prepare your molds with the tip below and add the mixture. Bake in a preheated oven at 180 C for 35 minutes or until a knife comes out clean.", "uses": []}, {	ext": "Extra tip: to prevent sticking, mix 1 teaspoon of cocoa powder with 1 teaspoon of butter or neutral oil and spread this mixture on your mini cocotte from @victoriacocinacastiron", "uses": []}, {	ext": "Tip 2: a little raw mixture and add it when it comes out of the oven. If you prefer not to add raw mixture you can make a mixture of Milo and cream as a sauce", "uses": []}]}]}